# KYNYX server environment.
# Copy to .env and fill in real values. Never commit secrets.

# Port the Express API listens on
PORT=5000

# MongoDB connection string (leave empty to run in demo mode —
# inquiries are logged instead of persisted)
MONGODB_URI=mongodb+srv://kynyx:kynyx1234@cluster0.q3pwlfn.mongodb.net/?appName=Cluster0

# Resend API key (leave empty to skip email sending in demo mode)
RESEND_API_KEY=

# From address for outgoing emails — must be a verified domain in Resend
RESEND_FROM_EMAIL=KYNYX <hello@yourdomain.com>

# Where internal notifications are delivered
CONTACT_RECEIVER_EMAIL=hello@yourdomain.com

# Origin of the frontend (used for CORS)
CLIENT_URL=http://localhost:5173

# Number of reverse-proxy hops in front of this server (nginx, load balancer,
# Docker, etc.) — required for correct client IPs / rate limiting. Set to 0
# if the server is reachable directly with no proxy in front of it.
TRUST_PROXY=1

# Node environment
NODE_ENV=development
